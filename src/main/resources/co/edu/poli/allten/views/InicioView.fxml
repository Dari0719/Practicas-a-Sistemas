<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="600.0" prefWidth="800.0" spacing="30.0" 
      stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="co.edu.poli.allten.controller.ControladorJuego">
    <children>
        <Label styleClass="title-label" text="Allten" />
        
        <VBox maxWidth="350.0" spacing="8.0">
            <children>
                <Label styleClass="input-label" text="TU NICKNAME" />
                <TextField fx:id="txtNickname" promptText="Númeromaster" styleClass="nickname-input" />
                <Button fx:id="btnIniciar" maxWidth="1.7976931348623157E308" 
                        onAction="#onIniciarPartida" styleClass="btn-primary" text="Iniciar Partida">
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>
                </Button>
            </children>
        </VBox>
    </children>
</VBox>