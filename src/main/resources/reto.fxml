<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="co.edu.poli.allten.RetoController"
      styleClass="pantalla"
      spacing="10"
      prefWidth="480" prefHeight="720">

    <padding>
        <Insets top="24" right="20" bottom="24" left="20"/>
    </padding>

    <Label text="Cuatro números, diez objetivos" styleClass="titulo" wrapText="true"/>
    <Label text="Combina los cuatro números, usando cada uno una sola vez, para llegar a cada objetivo del 1 al 10."
           styleClass="intro" wrapText="true"/>

    <!-- Números disponibles -->
    <Label text="Números disponibles" styleClass="subtitulo"/>
    <HBox fx:id="fichasBox" spacing="10" styleClass="fichas-box">
        <!-- Las fichas (Button) se generan por código: ficha1, ficha2, ficha3, ficha4 -->
    </HBox>

    <!-- Operaciones -->
    <HBox spacing="10" alignment="CENTER" styleClass="operaciones-box">
        <Button fx:id="btnSuma" text="+" styleClass="op-boton" onAction="#onOperacion" userData="+"/>
        <Button fx:id="btnResta" text="−" styleClass="op-boton" onAction="#onOperacion" userData="-"/>
        <Button fx:id="btnMultiplica" text="×" styleClass="op-boton" onAction="#onOperacion" userData="*"/>
        <Button fx:id="btnDivide" text="÷" styleClass="op-boton" onAction="#onOperacion" userData="/"/>
    </HBox>

    <Label fx:id="estadoLabel" text="Elige un número para empezar." styleClass="estado" wrapText="true"/>

    <HBox spacing="10" styleClass="acciones-box">
        <Button fx:id="btnDeshacer" text="Deshacer" styleClass="boton-secundario" onAction="#onDeshacer" disable="true"/>
        <Button fx:id="btnReiniciar" text="Reiniciar números" styleClass="boton-secundario" onAction="#onReiniciar"/>
        <Button fx:id="btnNuevoReto" text="Nuevo reto" styleClass="boton-secundario" onAction="#onNuevoReto"/>
    </HBox>

    <!-- Objetivos -->
    <Label text="Objetivos" styleClass="subtitulo"/>
    <Label fx:id="progresoLabel" text="0 de 10 objetivos conseguidos" styleClass="progreso"/>

    <GridPane fx:id="objetivosGrid" hgap="10" vgap="10" styleClass="objetivos-grid">
        <columnConstraints>
            <ColumnConstraints percentWidth="50"/>
            <ColumnConstraints percentWidth="50"/>
        </columnConstraints>
        <!-- Las 10 celdas de objetivo (Label o Button) se generan por código -->
    </GridPane>

</VBox>
