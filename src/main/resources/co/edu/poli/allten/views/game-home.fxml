<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="homeRoot" prefHeight="500.0" prefWidth="800.0" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" styleClass="root">
    <top>
        <HBox alignment="CENTER">
            <children>
                <Label id="title-label" text="Allten">
                    <font>
                        <Font name="System Bold" size="36.0"/>
                    </font>
                </Label>
            </children>
            <padding>
                <Insets top="42.0" right="0.0" bottom="0.0" left="0.0"/>
            </padding>
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER" maxWidth="430.0" spacing="8.0">
            <children>
                <Label id="nickname-label" text="NICKNAME">
                    <font>
                        <Font name="System Bold" size="9.0"/>
                    </font>
                </Label>
                <TextField id="nickname-field" prefHeight="38.0" promptText="Númeromaster" />
                <Label id="status-label" visible="false" managed="false" text="" />
                <Button id="start-button" maxWidth="1.7976931348623157E308" prefHeight="36.0" text="Iniciar Partida" />
            </children>
            <padding>
                <Insets top="20.0" right="0.0" bottom="0.0" left="0.0"/>
            </padding>
        </VBox>
    </center>

</BorderPane>
