/* Configuración General */
.root {
    -fx-font-family: "Segoe UI", Helvetica, Arial, sans-serif;
    -fx-background-color: #EFEFEF;
}

/* Pantalla de Inicio */
.title-label {
    -fx-font-size: 42px;
    -fx-font-weight: bold;
    -fx-text-fill: #111111;
}

.input-label {
    -fx-font-size: 11px;
    -fx-font-weight: bold;
    -fx-text-fill: #666666;
}

.nickname-input {
    -fx-pref-height: 45px;
    -fx-background-color: #FFFFFF;
    -fx-border-color: #CCCCCC;
    -fx-border-radius: 25px;
    -fx-background-radius: 25px;
    -fx-padding: 0 20px;
    -fx-font-size: 14px;
}

.btn-primary {
    -fx-pref-height: 48px;
    -fx-background-color: #111111;
    -fx-text-fill: #FFFFFF;
    -fx-font-weight: bold;
    -fx-font-size: 15px;
    -fx-background-radius: 25px;
    -fx-cursor: hand;
}

.btn-primary:hover {
    -fx-background-color: #333333;
}

/* Tablero de Juego (Game View) */
.header-bar {
    -fx-background-color: #FFFFFF;
    -fx-padding: 10px 20px;
    -fx-border-color: #E0E0E0;
    -fx-border-width: 0 0 1 0;
}

.game-title {
    -fx-font-size: 22px;
    -fx-font-weight: bold;
    -fx-text-fill: #0F3A5D;
}

.date-label {
    -fx-font-size: 20px;
    -fx-font-weight: bold;
    -fx-text-fill: #1C3041;
}

/* Celdas de los Objetivos (1 al 10) */
.objective-box {
    -fx-background-color: #E2E4E7;
    -fx-background-radius: 6px;
    -fx-pref-height: 38px;
    -fx-padding: 0 10px;
}

.objective-number {
    -fx-font-size: 18px;
    -fx-font-weight: bold;
    -fx-text-fill: #0F3A5D;
}

/* Visualizador de la Expresión Ingresada */
.display-box {
    -fx-background-color: #E2E4E7;
    -fx-background-radius: 12px;
    -fx-pref-height: 50px;
    -fx-alignment: center;
}

.display-text {
    -fx-font-size: 20px;
    -fx-font-weight: bold;
    -fx-text-fill: #0F3A5D;
}

/* Botones Circulares del Teclado */
.btn-circle-num {
    -fx-min-width: 58px;
    -fx-min-height: 58px;
    -fx-max-width: 58px;
    -fx-max-height: 58px;
    -fx-background-radius: 29px;
    -fx-background-color: #D3002A;
    -fx-text-fill: #FFFFFF;
    -fx-font-size: 20px;
    -fx-font-weight: bold;
    -fx-cursor: hand;
}

.btn-circle-op {
    -fx-min-width: 54px;
    -fx-min-height: 54px;
    -fx-max-width: 54px;
    -fx-max-height: 54px;
    -fx-background-radius: 27px;
    -fx-background-color: #123859;
    -fx-text-fill: #FFFFFF;
    -fx-font-size: 18px;
    -fx-font-weight: bold;
    -fx-cursor: hand;
}

.btn-circle-action {
    -fx-min-width: 54px;
    -fx-min-height: 54px;
    -fx-max-width: 54px;
    -fx-max-height: 54px;
    -fx-background-radius: 27px;
    -fx-background-color: #123859;
    -fx-text-fill: #FFFFFF;
    -fx-font-size: 16px;
    -fx-font-weight: bold;
    -fx-cursor: hand;
}

.btn-circle-submit {
    -fx-min-width: 64px;
    -fx-min-height: 64px;
    -fx-max-width: 64px;
    -fx-max-height: 64px;
    -fx-background-radius: 32px;
    -fx-background-color: #DCDDE1;
    -fx-text-fill: #123859;
    -fx-font-size: 22px;
    -fx-font-weight: bold;
    -fx-cursor: hand;
}