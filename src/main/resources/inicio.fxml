<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="480.0" prefWidth="640.0" styleClass="root-inicio" stylesheets="@estilos.css"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">

   <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="420.0" spacing="20.0" styleClass="panel">

      <Label styleClass="titulo" text="Allten" />

      <VBox alignment="CENTER_LEFT" spacing="6.0">
         <Label styleClass="etiqueta" text="NICKNAME" />
         <TextField fx:id="txtNickname" maxWidth="Infinity" promptText="Escribe tu nickname" styleClass="campo" />
      </VBox>

      <VBox alignment="CENTER_LEFT" spacing="6.0">
         <Label styleClass="etiqueta" text="MODO DE JUEGO" />
         <HBox spacing="12.0">
            <fx:define>
               <ToggleGroup fx:id="grupoModo" />
            </fx:define>
            <RadioButton fx:id="rbNormal" maxWidth="Infinity" selected="true" text="Normal"
                         toggleGroup="$grupoModo" HBox.hgrow="ALWAYS">
               <styleClass>
                  <String fx:value="modo" />
                  <String fx:value="modo-normal" />
               </styleClass>
            </RadioButton>
            <RadioButton fx:id="rbHardcore" maxWidth="Infinity" text="Hardcore"
                         toggleGroup="$grupoModo" HBox.hgrow="ALWAYS">
               <styleClass>
                  <String fx:value="modo" />
                  <String fx:value="modo-hardcore" />
               </styleClass>
            </RadioButton>
         </HBox>
      </VBox>

      <Button fx:id="btnIniciar" maxWidth="Infinity" styleClass="boton-primario" text="Iniciar Nueva Partida" />
   </VBox>
</StackPane>