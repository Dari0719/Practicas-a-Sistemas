<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane id="summary-root" prefHeight="680.0" prefWidth="760.0" styleClass="summary-root" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
    <center>
        <VBox alignment="CENTER" maxWidth="520.0" spacing="14.0" styleClass="summary-panel">
            <Label text="PARTIDA COMPLETADA" styleClass="summary-title" />
            <Label text="Res resolviste los 10 objetivos" styleClass="summary-subtitle" />
            <Label id="summary-time-label" styleClass="summary-time" />
            <Label id="summary-ranking-label" styleClass="summary-ranking" visible="false" managed="false" />
            <VBox alignment="CENTER" spacing="10.0">
                <Button id="ranking-button" text="Ver ranking" styleClass="summary-button" />
                <Button id="home-button" text="Volver al inicio" styleClass="summary-secondary-button" />
            </VBox>
            <padding>
                <Insets top="36.0" right="36.0" bottom="36.0" left="36.0" />
            </padding>
        </VBox>
    </center>
</BorderPane>
